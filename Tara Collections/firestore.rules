rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection - only authenticated users can read/write their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Products collection - readable by all, writable by admin (user with admin role)
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();

      // Subcollection: Product reviews
      match /reviews/{reviewId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    // Orders collection - readable by authenticated users for their own orders
    match /orders/{orderId} {
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid || // User's own order
        isAdmin() // Admin can read all orders
      );
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        resource.data.userId == request.auth.uid || // User updating their own order
        isAdmin() // Admin can update any order
      );
      allow delete: if isAdmin();
    }

    // Carts collection - only user can read/write their own cart
    match /carts/{cartId} {
      allow read, write: if request.auth != null && request.auth.uid == cartId;
    }

    // Reviews collection - readable by all, writable by authenticated users
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Wishlist collection - only user can read/write their own wishlist
    match /wishlists/{wishlistId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Payments collection - track payment verifications
    match /payments/{paymentId} {
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
    }

    // Customers collection - admin readable/writable, users can read public profiles
    match /customers/{customerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Banners collection - readable by all, writable by admin
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Collections collection - readable by all, writable by admin
    match /collections/{collectionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Website settings - readable by all, writable by admin
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Analytics collection - admin only
    match /analytics/{docId} {
      allow read, write: if isAdmin();
    }

    // Admin check function
    function isAdmin() {
      return request.auth != null &&
             gets(database.collection('admins').document(request.auth.uid)).data.isAdmin == true;
    }
  }